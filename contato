    <!-- CONTATO -->

    <section class="contatos">

        <h1 class="contatos-titulo">

            Entre em Contato

        </h1>

        <form id="formulario" class="formulario-contato">

            <!-- Nome -->

            <div class="grupo-form">

                <input type="text" id="nome" class="campo-form" placeholder="Digite seu nome">

            </div>

            <!-- Email -->

            <div class="grupo-form">

                <input type="email" id="email" class="campo-form" placeholder="Digite seu e-mail">

            </div>

            <!-- Senha -->

            <div class="grupo-form">

                <input type="password" id="senha" class="campo-form" placeholder="Digite uma senha">

            </div>

            <!-- Mensagem -->

            <div class="grupo-form">

                <textarea id="mensagem" class="campo-form" rows="6" placeholder="Digite sua mensagem"></textarea>

            </div>

            <!-- Botão -->

            <button type="submit" class="botao-enviar">

                Enviar Mensagem

            </button>

            <!-- Resultado JS -->

            <p id="resultado" style="
                margin-top:20px;
                text-align:center;
                font-weight:bold;">
            </p>

        </form>

    </section>

